# LLM API 키는 더 이상 서버에 저장하지 않습니다 — 각 사용자가 프론트엔드에서
# 자신의 API 키를 입력하면 요청마다 브라우저 → 백엔드로 전달되어 그 자리에서만 사용됩니다.

# apps/web의 UPLOAD_TOKEN_SECRET과 반드시 동일해야 함
UPLOAD_TOKEN_SECRET=change-me-shared-with-frontend

# Next.js 배포 주소 (쉼표로 여러 개 가능). CORS 허용 origin.
FRONTEND_ORIGIN=http://localhost:3000

# 업로드/작업 결과 저장 위치 (Render 등에 배포 시 영구 디스크 마운트 경로를 지정)
DATA_DIR=./data

# 업로드 가능한 도면 PDF 최대 용량(MB)
MAX_DRAWING_MB=150

# 제공자별 모델 이름 (선택, 기본값이 있으므로 보통 설정 불필요)
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_MODEL=gpt-4o
# GOOGLE_MODEL=gemini-2.0-flash
# XAI_MODEL=grok-2-latest
