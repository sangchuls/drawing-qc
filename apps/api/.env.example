# Claude API 키 (AI 검토 엔진에서 사용)
ANTHROPIC_API_KEY=sk-ant-...

# apps/web의 UPLOAD_TOKEN_SECRET과 반드시 동일해야 함
UPLOAD_TOKEN_SECRET=change-me-shared-with-frontend

# Next.js 배포 주소 (쉼표로 여러 개 가능). CORS 허용 origin.
FRONTEND_ORIGIN=http://localhost:3000

# 업로드/작업 결과 저장 위치 (Railway/Fly의 영구 볼륨 경로를 지정)
DATA_DIR=./data

# 업로드 가능한 도면 PDF 최대 용량(MB)
MAX_DRAWING_MB=150
